<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_log_tree" model="ir.ui.view">
        <field name="name">sale.order.line.log.tree</field>
        <field name="model">sale.order.line.log</field>
        <field name="arch" type="xml">
            <list string="Change Logs" create="false" edit="false" delete="false">
                <field name="write_date" string="Date"/>
                <field name="user_id" string="Changed By"/>
                <field name="field_description" string="Field"/>
                <field name="old_value" string="Old Value"/>
                <field name="new_value" string="New Value"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_log_form" model="ir.ui.view">
        <field name="name">sale.order.line.log.form</field>
        <field name="model">sale.order.line.log</field>
        <field name="arch" type="xml">
            <form string="Change Log" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="order_line_id" readonly="1"/>
                        <field name="write_date" string="Date" readonly="1"/>
                        <field name="user_id" string="Changed By" readonly="1"/>
                        <field name="field_description" string="Field" readonly="1"/>
                        <field name="old_value" string="Old Value" readonly="1"/>
                        <field name="new_value" string="New Value" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_line_log" model="ir.actions.act_window">
        <field name="name">Sale Order Line Change Logs</field>
        <field name="res_model">sale.order.line.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Inherit sale order form to show change log on lines -->
    <record id="view_sale_order_line_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.change.log</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Change Log" name="change_log">
                    <field name="change_log_ids" nolabel="1">
                        <list string="Change Logs" create="false" edit="false" delete="false">
                            <field name="write_date" string="Date"/>
                            <field name="user_id" string="Changed By"/>
                            <field name="field_description" string="Field"/>
                            <field name="old_value" string="Old Value"/>
                            <field name="new_value" string="New Value"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
