<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Extend the POS receipt screen to add an "Imprimer BL (A4)" button.
        The button appears right below the existing Print buttons when the POS
        config has `show_bl_a4` enabled and the order has a server-side ID.
    -->
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]//div[hasclass('d-flex') and hasclass('gap-1')]" position="after">
            <button
                t-if="pos.config.show_bl_a4 and this.currentOrder.id"
                class="button print btn btn-lg btn-secondary w-100 py-3"
                t-on-click="() => this.printBLA4()">
                <i class="fa fa-file-pdf-o me-1"/>
                Imprimer BL (A4)
            </button>
        </xpath>
    </t>

</templates>
