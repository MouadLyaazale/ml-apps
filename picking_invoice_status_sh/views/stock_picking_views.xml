<odoo>
    <!-- LISTE des livraisons -->
    <record id="view_picking_list_inherit_ml_statut_facturation" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.ml.statut.facturation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="ml_statut_facturation"
                       widget="badge"
                       string="Statut de facturation"
                       decoration-success="ml_statut_facturation == 'invoiced'"
                       decoration-warning="ml_statut_facturation == 'to_invoice'"
                       decoration-muted="ml_statut_facturation == 'not_ready'"/>
            </xpath>
        </field>
    </record>

    <!-- FORMULAIRE livraison -->
    <record id="view_picking_form_inherit_ml_statut_facturation" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.ml.statut.facturation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group[1]" position="inside">
                <field name="ml_statut_facturation"
                       widget="badge"
                       readonly="1"
                       string="Statut de facturation"
                       decoration-success="ml_statut_facturation == 'invoiced'"
                       decoration-warning="ml_statut_facturation == 'to_invoice'"
                       decoration-muted="ml_statut_facturation == 'not_ready'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_inherit_ml_statut_facturation" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.ml.statut.facturation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='delivery']" position="after">
                <filter name="ml_invoiced" string="BL Facturé" domain="[('ml_statut_facturation', '=', 'invoiced')]"/>
                <filter name="ml_to_invoice" string="BL Prêt à facturer" domain="[('ml_statut_facturation', '=', 'to_invoice')]"/>
                <filter name="ml_not_ready" string="BL Non prêt" domain="[('ml_statut_facturation', '=', 'not_ready')]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter string="Statut de facturation" name="group_ml_statut_facturation" context="{'group_by': 'ml_statut_facturation'}"/>
            </xpath>
        </field>
    </record>
</odoo>
