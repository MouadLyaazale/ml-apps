<odoo>

    <record id="crm_action_template_list" model="ir.ui.view">
        <field name="name">crm.action.template.list</field>
        <field name="model">crm.action.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="crm_action_template_form" model="ir.ui.view">
        <field name="name">crm.action.template.form</field>
        <field name="model">crm.action.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Rows">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="label"/>
                                    <field name="value_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_action_template" model="ir.actions.act_window">
        <field name="name">Commercial Actions Templates</field>
        <field name="res_model">crm.action.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_crm_action_template"
              name="Commercial Actions Templates"
              parent="crm.crm_menu_config"
              action="action_crm_action_template"
              sequence="50"/>
</odoo>
