<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajout des champs PIN / Badge dans la fiche employé -->
    <record id="atelier_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">atelier.hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Kiosque Atelier" name="atelier_kiosque">
                    <group string="Identification">
                        <field name="atelier_pin"
                               string="Code PIN (4-6 chiffres)"
                               password="True"
                               placeholder="ex: 1234"/>
                        <field name="atelier_badge_id"
                               string="Numéro de badge"
                               placeholder="Scan ou saisie manuelle"/>
                    </group>
                    <group string="Paramètres atelier">
                        <field name="atelier_is_supervisor"
                               string="Superviseur atelier"
                               widget="boolean_toggle"/>
                        <field name="atelier_shift_id"
                               string="Vacation habituelle"
                               options="{&apos;no_create&apos;: False}"/>
                        <field name="atelier_auto_logout_minutes"
                               string="Déconnexion auto (min, 0=global)"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Le code PIN est confidentiel. Il permet au technicien de
                        s'identifier sur le kiosque <strong>/atelier</strong> sans
                        avoir besoin de compte Odoo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
