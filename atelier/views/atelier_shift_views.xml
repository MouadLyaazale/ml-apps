<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ── -->
    <record id="atelier_shift_list" model="ir.ui.view">
        <field name="name">atelier.shift.list</field>
        <field name="model">atelier.shift</field>
        <field name="arch" type="xml">
            <list string="Vacations atelier" editable="bottom">
                <field name="name"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour"   widget="float_time"/>
                <field name="auto_close_timers"/>
                <field name="active"     widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ── Form ── -->
    <record id="atelier_shift_form" model="ir.ui.view">
        <field name="name">atelier.shift.form</field>
        <field name="model">atelier.shift</field>
        <field name="arch" type="xml">
            <form string="Vacation atelier">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour"   widget="float_time"/>
                        </group>
                        <group>
                            <field name="auto_close_timers"/>
                            <field name="active"     widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="employee_ids"
                           widget="many2many_tags"
                           string="Techniciens affectés"
                           options="{'no_create': True}"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="atelier_shift_action" model="ir.actions.act_window">
        <field name="name">Vacations atelier</field>
        <field name="res_model">atelier.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
