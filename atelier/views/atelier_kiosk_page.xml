<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Page standalone servie par /atelier -->
    <template id="kiosk_page" name="Atelier Kiosque">
        <html lang="fr">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Atelier</title>
                <link rel="icon" href="/web/static/img/favicon.ico"/>
                <link rel="stylesheet"
                      type="text/css"
