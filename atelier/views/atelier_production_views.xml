<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Ajout du champ "Lancé" + techniciens sur le form OF
         ============================================================ -->
    <record id="atelier_mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">atelier.mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Bouton "Lancer" dans la barre d'état (après le bouton Start) -->
            <xpath expr="//header/button[@name='action_start']" position="after">
                <button name="action_lancer"
                        string="🔧 Lancer l'atelier"
                        type="object"
                        class="btn-primary"
                        invisible="is_lancer or state in ('done','cancel','draft')"
                        confirm="Voulez-vous lancer cet OF vers le kiosque atelier ?"/>
                <button name="action_retirer_lancer"
                        string="⏹ Retirer du kiosque"
                        type="object"
                        class="btn-warning"
                        invisible="not is_lancer"/>
            </xpath>

            <!-- Onglet techniciens assignés (ajouté en dernier dans le notebook) -->
            <xpath expr="//notebook" position="inside">
                <page string="Kiosque Atelier" name="atelier_kiosque">
                    <group>
                        <field name="is_lancer"
                               string="Visible dans le kiosque"
                               widget="boolean_toggle"/>
                        <field name="atelier_priority"
                               widget="radio"
                               string="Priorité"/>
                    </group>
                    <label for="atelier_worker_ids" string="Techniciens assignés"/>
                    <field name="atelier_worker_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <div class="alert alert-info mt-3" role="alert">
                        Seuls les techniciens listés ci-dessus verront cet OF dans
                        le kiosque atelier Schiele. Le kiosque est accessible sur
                        <strong>/atelier</strong>.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Vue liste – colonnes Lancé + Priorité
         ============================================================ -->
    <record id="atelier_mrp_production_list_inherit" model="ir.ui.view">
        <field name="name">atelier.mrp.production.list.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="atelier_priority"
                       string="Priorité"
                       widget="badge"
                       decoration-success="atelier_priority == '0'"
                       decoration-warning="atelier_priority == '1'"
                       decoration-danger="atelier_priority == '2'"
                       optional="show"/>
                <field name="is_lancer"
                       string="Kiosque"
                       widget="boolean"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Vue liste "OF Lancés" dédiée au superviseur
         ============================================================ -->
    <record id="atelier_mrp_production_lancer_list" model="ir.ui.view">
        <field name="name">atelier.mrp.production.lancer.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list string="OF Lancés" decoration-info="state == 'confirmed'"
                  decoration-success="state == 'progress'"
                  decoration-muted="state == 'to_close'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="date_start"/>
                <field name="atelier_worker_ids" widget="many2many_tags"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'progress'"
                       decoration-warning="state == 'to_close'"/>
                <field name="is_lancer" invisible="1"/>
                <button name="action_retirer_lancer"
                        type="object"
                        icon="fa-times"
                        title="Retirer du kiosque"/>
            </list>
        </field>
    </record>

    <record id="atelier_mrp_production_lancer_action" model="ir.actions.act_window">
        <field name="name">OF Lancés – Kiosque</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_lancer', '=', True), ('state', 'not in', ['done', 'cancel'])]</field>
        <field name="view_id" ref="atelier_mrp_production_lancer_list"/>
        <field name="context">{'default_is_lancer': True}</field>
    </record>

</odoo>
