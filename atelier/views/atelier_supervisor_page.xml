<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tableau de bord superviseur (accès via session Odoo) -->
    <template id="supervisor_page" name="Superviseur – Tableau de bord Atelier">
        <html lang="fr">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Superviseur – Atelier</title>
                <link rel="icon" href="/web/static/img/favicon.ico"/>
                <link rel="stylesheet" href="/atelier/static/src/css/atelier.css"/>
                <link rel="stylesheet" href="/atelier/static/src/css/supervisor.css"/>
            </head>
            <body class="atelier-kiosk-body supervisor-body">
                <div class="atelier-header">
                    <div class="atelier-header-logo">
                        ⚙️ Atelier — <span style="color:#fbbc04">Superviseur</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:16px">
                        <span style="color:var(--atelier-muted)" id="sv-user-name">
                            <t t-esc="user_name"/>
                        </span>
                        <div class="atelier-header-clock" id="sv-clock"></div>
                        <a href="/web" class="atelier-logout-btn">↩ Backend</a>
                        <a href="/atelier" class="atelier-logout-btn" target="_blank">🖥 Kiosque</a>
                    </div>
                </div>

                <div id="sv-root" class="sv-root">
                    <!-- Tabs -->
                    <div class="sv-tabs">
                        <button class="sv-tab active" data-tab="active">🟢 Actifs maintenant</button>
                        <button class="sv-tab" data-tab="mos">📋 OF Lancés</button>
                        <button class="sv-tab" data-tab="employees">👷 Techniciens du jour</button>
                        <button class="sv-tab" data-tab="shifts">🕐 Vacations</button>
                        <button class="sv-tab" data-tab="stats">📊 Performance</button>
                    </div>

                    <!-- Toast area -->
                    <div id="sv-toast-area"></div>

                    <!-- Tab: Actifs -->
                    <div class="sv-panel" id="sv-tab-active">
                        <div class="sv-refresh-bar">
                            <span id="sv-last-refresh" class="sv-muted">—</span>
                            <button class="sv-action-btn" id="sv-refresh-btn">↺ Actualiser</button>
                        </div>
                        <div id="sv-active-list" class="sv-card-grid">
                            <div class="sv-loading">Chargement…</div>
                        </div>
                    </div>

                    <!-- Tab: MOs -->
                    <div class="sv-panel hidden" id="sv-tab-mos">
                        <div id="sv-mo-list"></div>
                    </div>

                    <!-- Tab: Employees -->
                    <div class="sv-panel hidden" id="sv-tab-employees">
                        <div id="sv-emp-list" class="sv-card-grid"></div>
                    </div>

                    <!-- Tab: Shifts -->
                    <div class="sv-panel hidden" id="sv-tab-shifts">
                        <div id="sv-shift-list"></div>
                    </div>

                    <!-- Tab: Performance / Stats -->
                    <div class="sv-panel hidden" id="sv-tab-stats">
                        <div class="sv-stats-controls">
                            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                                <button class="sv-period-btn active" data-period="day">Aujourd'hui</button>
                                <button class="sv-period-btn" data-period="week">Cette semaine</button>
                                <button class="sv-period-btn" data-period="month">Ce mois</button>
                            </div>
                            <button class="sv-action-btn" id="sv-stats-refresh-btn">↺ Actualiser</button>
                        </div>
                        <div id="sv-stats-list" class="sv-stats-list">
                            <div class="sv-loading">Chargement…</div>
                        </div>
                        <div class="sv-timeline-section">
                            <div class="sv-timeline-title">📅 Timeline du jour</div>
                            <div id="sv-timeline-container"></div>
                        </div>
                    </div>
                </div>

                <script type="text/javascript" src="/atelier/static/src/js/supervisor_app.js">
                </script>
            </body>
        </html>
    </template>

</odoo>
