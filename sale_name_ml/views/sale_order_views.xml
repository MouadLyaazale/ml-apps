<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_order_form_divers_fields" model="ir.ui.view">
    <field name="name">sale.order.form.divers.fields</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="x_real_customer_name" invisible="not x_is_divers" required="x_is_divers"/>
        <field name="x_real_customer_address" invisible="not x_is_divers" required="x_is_divers"/>
        <field name="x_real_customer_ice" invisible="not x_is_divers"/>
      </xpath>
    </field>
  </record>
</odoo>
