<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_res_config_settings_divers_partner" model="ir.ui.view">
    <field name="name">res.config.settings.divers.partner</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <div class="app_settings_block" string="Sales - Divers">
          <h2>Sales - Divers</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="divers_partner_id"/>
                <div class="text-muted">Choose the partner used as Divers for quotations.</div>
                <field name="divers_partner_id"/>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
