<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="sale_report_divers_realcontact" inherit_id="sale.report_saleorder_document">
    <xpath expr="(//*[@t-field and contains(@t-field,'doc.partner_id')])[1]
                 |(//*[@t-esc and contains(@t-esc,'doc.partner_id')])[1]"
           position="replace">
      <t t-if="doc.x_is_divers">
        <div>
          <strong t-esc="doc.x_real_customer_name or ''"/>
          <div t-if="doc.x_real_customer_address" style="white-space: pre-line;">
            <t t-esc="doc.x_real_customer_address"/>
          </div>
          <div t-if="doc.x_real_customer_ice">
            <span>ICE: </span><span t-esc="doc.x_real_customer_ice"/>
          </div>
        </div>
      </t>
      <t t-else="">
        <span t-field="doc.partner_id"/>
      </t>
    </xpath>
  </template>
</odoo>
