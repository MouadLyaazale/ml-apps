<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_wizard" model="ir.ui.view">
    <field name="name">pos.change.payments.wizard.form</field>
    <field name="model">pos.change.payments.wizard</field>
    <field name="arch" type="xml">
      <form string="Change Payments">
        <group>
          <field name="order_id" readonly="1"/>
        </group>
        <field name="line_ids" nolabel="1">
          <list editable="bottom">
            <field name="payment_method_id"/>
            <field name="amount"/>
          </list>
        </field>
        <footer>
          <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_wizard" model="ir.actions.act_window">
    <field name="name">Change Payments</field>
    <field name="res_model">pos.change.payments.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
