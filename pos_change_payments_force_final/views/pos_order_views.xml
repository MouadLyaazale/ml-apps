<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="pos_force_btn_final" model="ir.ui.view">
    <field name="name">pos.order.form.change.payments.force.final</field>
    <field name="model">pos.order</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_change_payments_wizard_force_final"
                type="object"
                string="Change Payments"
                class="btn-primary"
                groups="pos_change_payments_force_final.group_pos_change_payments"/>
      </xpath>
    </field>
  </record>
</odoo>
