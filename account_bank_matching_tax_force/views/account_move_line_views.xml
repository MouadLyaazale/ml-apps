<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Force VAT button to account move form -->
    <record id="view_account_move_form_inherit_force_vat" model="ir.ui.view">
        <field name="name">account.move.form.inherit.force.vat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_post']" position="after">
                <button name="action_force_vat_declaration_from_matching" 
                        string="🔥 Force VAT (345520)" 
                        type="object" 
                        class="btn-success"/>
            </xpath>
        </field>
    </record>
</odoo>
