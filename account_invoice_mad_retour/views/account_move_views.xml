<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_mad_retour" model="ir.ui.view">
        <field name="name">account.move.form.mad.retour</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="after">
                <label for="amount_total_mad" string="Total MAD"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                <field name="amount_total_mad" nolabel="1" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
            </xpath>

            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_origin']" position="after">
                <field name="retour_sur_bl" readonly="1" force_save="1"
                       invisible="move_type not in ('out_refund', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
